# Application Environment
NODE_ENV="production"
PORT=3000
APP_URL="https://example.com"
JWT_SECRET="trinetra_mausam_jwt_secret_change_in_production"

# PostgreSQL Database Configuration
# Defaults to embedded persistent PostgreSQL (PGlite in data/postgres) if DATABASE_URL is not set
# Optional: Set DATABASE_URL to connect an external PostgreSQL database
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trinetra_mausam"

# Supabase Database & Auth Configuration
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Redis Cache Configuration
# Defaults to self-hosted in-memory cache with TTL, SWR and circuit breakers if REDIS_URL is not set
REDIS_URL="redis://localhost:6379"

