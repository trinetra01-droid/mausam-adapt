# Application Environment
NODE_ENV="production"
PORT=3000
APP_URL="https://example.com"
JWT_SECRET="JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# PostgreSQL Database Configuration
# Defaults to embedded persistent PostgreSQL (PGlite) if DATABASE_URL is not set
DATABASE_URL="postgres://postgres:postgres@localhost:5432/trinetra_mausam"

# Redis Cache Configuration
# Defaults to self-hosted in-memory cache with TTL, SWR and circuit breakers if REDIS_URL is not set
REDIS_URL="redis://localhost:6379"

# Official Government of India Meteorological & Oceanographic APIs
# India Meteorological Department (IMD) - Ministry of Earth Sciences
# Register at: https://api.imd.gov.in/
IMD_API_KEY=""
IMD_API_BASE_URL="https://api.imd.gov.in/api"

# Indian National Centre for Ocean Information Services (INCOIS)
# Register at: https://incois.gov.in/
INCOIS_API_KEY=""
INCOIS_BASE_URL="https://incois.gov.in/api"

# Central Pollution Control Board (CPCB) - Air Quality Services
# Register at: https://cpcb.gov.in/
CPCB_API_KEY=""
CPCB_BASE_URL="https://api.cpcb.gov.in/api"

# MOSDAC / ISRO - Satellite & Oceanographic Data
# Register at: https://mosdac.gov.in/
MOSDAC_API_KEY=""
MOSDAC_USER_ID=""

# BHASHINI - National Language Translation Mission (MeitY)
# Register at: https://bhashini.gov.in/
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""
BHASHINI_PIPELINE_URL="https://meity-auth.ulcacontrib.org"

